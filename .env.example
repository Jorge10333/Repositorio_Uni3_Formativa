# URLs obligatorias de las APIs externas
GEO_API_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
CURRENCY_API_URL=https://api.frankfurter.dev/v2

# Parámetros de red y políticas de seguridad
REQUEST_TIMEOUT=5
ENABLE_OFFLINE_FALLBACK=True
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=5

# Usuario administrador inicial (la clave se pide por consola en el primer arranque)
ADMIN_INITIAL_USER=admin